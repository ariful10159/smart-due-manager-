rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // ✅ ADMIN HELPER — admins/{uid} ডকুমেন্ট থাকলেই সে admin
    // ============================================
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================
    // ✅ ADMINS COLLECTION — নিজের admin ডকুমেন্ট, অথবা অন্য কোনো admin
    // পড়তে/লিখতে পারবে (নতুন admin যোগ/বাদ দেওয়ার জন্য) — কিন্তু প্রথম admin
    // ডকুমেন্ট সবসময় Console/CLI দিয়ে ম্যানুয়ালি বসাতে হবে, কারণ non-admin
    // কখনোই নিজেকে admin বানাতে পারবে না (isAdmin() নিজেই আগে থেকে একটা
    // admins ডকুমেন্ট থাকা দাবি করে)।
    // ============================================
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ============================================
    // ✅ ADMIN AUDIT LOG — শুধু admin রা পড়তে/লিখতে পারবে
    // ============================================
    match /adminAuditLog/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================
    // ✅ ANNOUNCEMENTS COLLECTION — সব লগইন করা ইউজার পড়তে পারবে, শুধু admin লিখতে পারবে
    // ============================================
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ============================================
    // ✅ USERS COLLECTION — নিজের profile অথবা admin
    // ============================================
    match /users/{userId} {
      allow read, create, update: if request.auth != null &&
                                   (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================
    // ✅ CUSTOMERS COLLECTION — owner এর নিজের ডেটা অথবা admin
    // ============================================
    match /customers/{customerId} {

      // ✅ Read — owner অথবা admin
      allow read: if request.auth != null &&
                   (resource.data.ownerId == request.auth.uid || isAdmin());

      // ✅ Create — নতুন customer তৈরি
      allow create: if request.auth != null &&
                    request.resource.data.ownerId == request.auth.uid;

      // ✅ Update — 🛠️ এখানে due date বা createdAt ডেট লক করা হয়েছে!
      // 'createdAt' এবং প্রাথমিক ডিউ সংক্রান্ত ডেট একবার তৈরি হলে আর চেঞ্জ করা যাবে না।
      allow update: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin()) &&
                    request.resource.data.ownerId == resource.data.ownerId &&
                    (!request.resource.data.keys().hasAll(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt);

      // ✅ Delete — owner অথবা admin
      allow delete: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin());

      // ============================================
      // ✅ PAYMENTS SUBCOLLECTION (নিরাপদ রুলস)
      // 🛠️ পেমেন্ট ডকুমেন্টের 'date' ফিল্ড আপডেট করা লক করা হয়েছে!
      // ============================================
      match /payments/{paymentId} {
        allow read, create: if request.auth != null &&
                               (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin());

        // পেমেন্ট হয়ে যাওয়ার পর ট্রানজেকশন ডেট কেউ এডিট বা আপডেট করতে পারবে না (admin ছাড়া)
        allow update: if request.auth != null &&
                      (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin()) &&
                      (isAdmin() || request.resource.data.date == resource.data.date);

        allow delete: if request.auth != null &&
                      (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin());
      }

      // ============================================
      // ✅ REMINDERS SUBCOLLECTION
      // ============================================
      match /reminders/{reminderId} {
        allow read, write: if request.auth != null &&
                            (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin());
      }

      // ============================================
      // ✅ SMS LOGS SUBCOLLECTION
      // ============================================
      match /smsLogs/{logId} {
        allow read, write: if request.auth != null &&
                            (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // ============================================
    // ✅ NOTEBOOKS COLLECTION — owner এর নিজের notebook অথবা admin
    // ============================================
    match /notebooks/{notebookId} {
      allow read: if request.auth != null &&
                   (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if request.auth != null &&
                    request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin()) &&
                    request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin());

      // ============================================
      // ✅ PAGES SUBCOLLECTION
      // ============================================
      match /pages/{pageId} {
        allow read, write: if request.auth != null &&
                            (get(/databases/$(database)/documents/notebooks/$(notebookId)).data.ownerId == request.auth.uid || isAdmin());
      }
    }

    // ডিফল্টভাবে অন্য সব রিড-রাইট বন্ধ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
