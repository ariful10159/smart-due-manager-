rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // ✅ ADMIN HELPER — admins/{uid} ডকুমেন্ট থাকলেই সে admin
    // ============================================
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============================================
    // ✅ SUPER ADMIN HELPER — 'staff' admin-রা এই সবচেয়ে destructive ডেটা-মোছার
    // path গুলো (অন্যের users/customers/notebooks ডকুমেন্ট ডিলিট) দিয়ে পুরো
    // deleteUserData cascade-টা নিজে থেকেই manual Firestore write দিয়ে
    // পুনরায় তৈরি করতে না পারে, সেজন্য। role field না থাকলে (পুরনো admin
    // ডকুমেন্ট) super হিসেবেই ধরা হয় — functions/index.js এর roleOf() এর
    // সাথে সামঞ্জস্যপূর্ণ।
    // ============================================
    function isSuperAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role != 'staff';
    }

    // ============================================
    // ✅ ACCEPTED-VERSION SELF-WRITE HELPER — users/{uid} এ acceptedPrivacyVersion/
    // acceptedTermsVersion touched (create-এ present, বা update-এ changed) হলে প্রতিটা
    // ফিল্ড হয় '0' (মানে "এখনো accept করেনি" — honest fallback, lib/services/
    // auth_service.dart config fetch fail করলে এটাই লেখে, PolicyAcceptanceGate
    // এমনিতেই আবার দেখাবে) অথবা appConfig/main এ বর্তমান published version-এর সাথে
    // ঠিক মিলতে হবে — নাহলে fake উঁচু version বসিয়ে re-acceptance বাইপাস করা যেত।
    // appConfig/main এখনো তৈরিই না হয়ে থাকলে (bootstrapping) চেকটা স্কিপ হয়।
    // ============================================
    function acceptedVersionsSelfWriteOk(touched) {
      return !touched ||
        !exists(/databases/$(database)/documents/appConfig/main) ||
        (
          (request.resource.data.acceptedPrivacyVersion == 0 ||
           request.resource.data.acceptedPrivacyVersion ==
               get(/databases/$(database)/documents/appConfig/main).data.privacyVersion) &&
          (request.resource.data.acceptedTermsVersion == 0 ||
           request.resource.data.acceptedTermsVersion ==
               get(/databases/$(database)/documents/appConfig/main).data.termsVersion)
        );
    }

    // ============================================
    // ✅ ADMINS COLLECTION — নিজের admin ডকুমেন্ট, অথবা অন্য কোনো admin পড়তে পারবে।
    // Write সবসময় false — add/remove/role-change শুধু addAdmin / removeAdmin /
    // setAdminRole Cloud Functions দিয়ে হয় (functions/index.js), যেখানে caller
    // super admin কিনা এবং শেষ super admin remove/demote হয়ে যাচ্ছে কিনা — এই
    // চেকগুলো server-side এ enforce করা হয়। প্রথম admin ডকুমেন্ট সবসময়
    // Console/CLI দিয়ে ম্যানুয়ালি বসাতে হবে।
    // ============================================
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // ============================================
    // ✅ ADMIN AUDIT LOG — শুধু admin রা পড়তে/লিখতে পারবে
    // ============================================
    match /adminAuditLog/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================
    // ✅ ANNOUNCEMENTS COLLECTION — সব লগইন করা ইউজার পড়তে পারবে, শুধু admin লিখতে পারবে
    // ============================================
    match /announcements/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ============================================
    // ✅ APP CONFIG — সিঙ্গেলটন ডকুমেন্ট (appConfig/main): app version, maintenance
    // mode, force update, privacy/terms override, contact info ইত্যাদি। লগইন করার
    // আগেও (splash/login স্ক্রিনেও) maintenance/force-update চেক করতে হয়, তাই read
    // পাবলিক — এতে কোনো sensitive ডেটা নেই। লেখা শুধু admin.
    // ============================================
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      // History subcollections — শুধু admin panel দেখে/লেখে, app এর দরকার নেই
      match /versionHistory/{id} {
        allow read, write: if isAdmin();
      }
      match /privacyHistory/{id} {
        allow read, write: if isAdmin();
      }
      match /termsHistory/{id} {
        allow read, write: if isAdmin();
      }
    }

    // ============================================
    // ✅ PUSH NOTIFICATIONS COLLECTION — sendPushNotification Cloud Function এর পাঠানো
    // প্রতিটা push এর history রেকর্ড। Write সবসময় false — শুধু সেই Cloud Function
    // (Admin SDK দিয়ে, rules বাইপাস করে) লেখে; admin panel শুধু পড়ে (history list এর জন্য)।
    // ============================================
    match /pushNotifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // ✅ USER NOTIFICATIONS COLLECTION — sendPushNotification Cloud Function এর
    // পাঠানো প্রতিটা push এর per-user কপি, app-এর Notifications screen এ দেখানোর
    // জন্য। Write সবসময় false — শুধু সেই Cloud Function (Admin SDK) লেখে; ইউজার
    // শুধু নিজের (recipientUid == নিজের uid) গুলো পড়তে পারবে।
    // ============================================
    match /userNotifications/{id} {
      allow read: if request.auth != null &&
                   (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ============================================
    // ✅ FAQ COLLECTION — সবাই পড়তে পারবে (in-app FAQ স্ক্রিনের জন্য), শুধু admin লিখতে পারবে
    // ============================================
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================
    // ✅ USER ACTIVITY LOG — প্রতিটা ইউজার শুধু নিজের নামে (spoof করা যাবে না)
    // entry লিখতে পারবে, পড়তে পারবে শুধু admin — এটা একটা append-only audit trail
    // ============================================
    match /userActivityLog/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ============================================
    // ✅ PROBLEM REPORTS — ইউজার শুধু নিজের নামে (spoof করা যাবে না) রিপোর্ট
    // create করতে পারবে, নিজেরটা পড়তে পারবে; সব রিপোর্ট পড়া/status আপডেট
    // করা শুধু admin এর জন্য — যাতে master admin panel এ কোন ইউজার কোন
    // সমস্যা রিপোর্ট করেছে তা দেখা যায়।
    // ============================================
    match /problemReports/{reportId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
                   (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ============================================
    // ✅ USERS COLLECTION — নিজের profile অথবা admin
    // ✅ delete এ self-delete যোগ করা হয়েছে (আগে শুধু admin) — Delete Account
    // ফিচারে ইউজার নিজের users/{uid} ডকুমেন্ট নিজেই মুছে ফেলতে পারবে
    // (Google Play Data Safety policy অনুযায়ী in-app account deletion বাধ্যতামূলক)
    // ============================================
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Self-create এও 'disabled' লক (client কখনো এটা লেখে না) এবং accepted-version
      // fields present থাকলে সেগুলো published version-এর সাথে মেলা বাধ্যতামূলক —
      // নাহলে registration-এর সময়ই fake version বসিয়ে re-acceptance এড়ানো যেত।
      allow create: if request.auth != null &&
                    (request.auth.uid == userId || isAdmin()) &&
                    (
                      isAdmin() ||
                      (
                        !('disabled' in request.resource.data) &&
                        acceptedVersionsSelfWriteOk(
                          'acceptedPrivacyVersion' in request.resource.data ||
                          'acceptedTermsVersion' in request.resource.data
                        )
                      )
                    );

      // Self-update এ দুইটা compliance-sensitive জায়গা লক করা:
      // 1. 'disabled' — client কখনো এই ফিল্ড লেখে না (শুধু পড়ে, দেখুন
      //    lib/widgets/account_status_gate.dart), তাই non-admin এটা touch করলেই reject।
      // 2. acceptedPrivacyVersion/acceptedTermsVersion — changed হলে published version-এর
      //    সাথে মিলতে হবে (দেখুন acceptedVersionsSelfWriteOk() উপরে)।
      allow update: if request.auth != null &&
                    (request.auth.uid == userId || isAdmin()) &&
                    (
                      isAdmin() ||
                      (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled']) &&
                        acceptedVersionsSelfWriteOk(
                          request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['acceptedPrivacyVersion', 'acceptedTermsVersion'])
                        )
                      )
                    );

      // Admin-initiated delete (নিজের account না) শুধু super admin — staff যাতে
      // deleteUserData Cloud Function বাইপাস করে অন্যের users ডকুমেন্ট সরাসরি
      // মুছতে না পারে। নিজের account delete (Delete Account ফিচার) সবার জন্য অক্ষত।
      allow delete: if request.auth != null &&
                    (request.auth.uid == userId || isSuperAdmin());
    }

    // ============================================
    // ✅ CUSTOMERS COLLECTION — owner এর নিজের ডেটা অথবা admin
    // ============================================
    match /customers/{customerId} {

      // ✅ Read — owner অথবা admin
      allow read: if request.auth != null &&
                   (resource.data.ownerId == request.auth.uid || isAdmin());

      // ✅ Create — নতুন customer তৈরি
      allow create: if request.auth != null &&
                    request.resource.data.ownerId == request.auth.uid;

      // ✅ Update — 🛠️ এখানে due date বা createdAt ডেট লক করা হয়েছে!
      // 'createdAt' এবং প্রাথমিক ডিউ সংক্রান্ত ডেট একবার তৈরি হলে আর চেঞ্জ করা যাবে না।
      allow update: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin()) &&
                    request.resource.data.ownerId == resource.data.ownerId &&
                    (!request.resource.data.keys().hasAll(['createdAt']) || request.resource.data.createdAt == resource.data.createdAt);

      // ✅ Delete — owner অথবা super admin (staff না — নিচের subcollection
      // delete rule গুলোও একই কারণে super-only, নাহলে deleteCustomer এর
      // cascade মাঝপথে আটকে গিয়ে customer আংশিক ডেটা নিয়ে থেকে যেতে পারে)
      allow delete: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isSuperAdmin());

      // ============================================
      // ✅ PAYMENTS SUBCOLLECTION (নিরাপদ রুলস)
      // 🛠️ পেমেন্ট ডকুমেন্টের 'date' ফিল্ড আপডেট করা লক করা হয়েছে!
      // ============================================
      match /payments/{paymentId} {
        // ✅ পেমেন্ট ডকুমেন্টে নিজেই 'ownerId' থাকলে (নতুন লেখা payment গুলোতে)
        // সরাসরি সেটা চেক করা হয় — parent customer doc এর জন্য আলাদা get()
        // লাগে না। পুরনো payment (যেগুলোতে এখনো 'ownerId' নেই) এর জন্য আগের
        // মতো parent-lookup fallback রাখা হয়েছে, যাতে কিছু ভেঙে না যায়।
        allow read: if request.auth != null &&
                      (resource.data.ownerId == request.auth.uid ||
                       (!('ownerId' in resource.data) &&
                        get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid) ||
                       isAdmin());

        allow create: if request.auth != null &&
                       request.resource.data.ownerId == request.auth.uid &&
                       (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin());

        // পেমেন্ট হয়ে যাওয়ার পর ট্রানজেকশন ডেট কেউ এডিট বা আপডেট করতে পারবে না (admin ছাড়া)
        allow update: if request.auth != null &&
                      (resource.data.ownerId == request.auth.uid ||
                       (!('ownerId' in resource.data) &&
                        get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid) ||
                       isAdmin()) &&
                      (isAdmin() || request.resource.data.date == resource.data.date);

        // Admin panel কখনো payment delete করে না নিজে থেকে, শুধু deleteCustomer এর
        // অংশ হিসেবে — তাই owner ছাড়া শুধু super admin।
        allow delete: if request.auth != null &&
                      (resource.data.ownerId == request.auth.uid ||
                       (!('ownerId' in resource.data) &&
                        get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid) ||
                       isSuperAdmin());
      }

      // ============================================
      // ✅ REMINDERS SUBCOLLECTION — admin panel এটা শুধু পড়ে (read-only), কখনো
      // লেখে না; write শুধু customer delete cascade এর অংশ হিসেবে super admin এর জন্য।
      // ============================================
      match /reminders/{reminderId} {
        allow read: if request.auth != null &&
                     (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if request.auth != null &&
                     (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isSuperAdmin());
      }

      // ============================================
      // ✅ SMS LOGS SUBCOLLECTION — reminders এর মতোই, admin panel read-only
      // ============================================
      match /smsLogs/{logId} {
        allow read: if request.auth != null &&
                     (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if request.auth != null &&
                     (get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid || isSuperAdmin());
      }
    }

    // ============================================
    // ✅ PAYMENTS COLLECTION GROUP QUERY — home screen এর today/week collection
    // স্ট্যাট প্রতিটা কাস্টমারের জন্য আলাদা query না করে collectionGroup('payments')
    // দিয়ে একটা মাত্র query তে চালায়। Firestore collection-group query চালাতে
    // হলে এই {path=**} wildcard প্যাটার্নেই আলাদা rule ঘোষণা করতে হয় (উপরের
    // customers/{customerId}/payments rule টা normal subcollection path access
    // এর জন্য থেকেই যায়, এটা শুধু collection-group scope এর জন্য অতিরিক্ত)।
    // শুধু document এ থাকা 'ownerId' চেক করা হয় — parent lookup লাগে না, তাই
    // পুরনো (migrate না হওয়া) payment গুলো এই query তে দেখা যাবে না।
    // ============================================
    match /{path=**}/payments/{paymentId} {
      allow read: if request.auth != null &&
                   (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // ============================================
    // ✅ NOTEBOOKS COLLECTION — owner এর নিজের notebook অথবা admin
    // ============================================
    match /notebooks/{notebookId} {
      allow read: if request.auth != null &&
                   (resource.data.ownerId == request.auth.uid || isAdmin());

      allow create: if request.auth != null &&
                    request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isAdmin()) &&
                    request.resource.data.ownerId == resource.data.ownerId;

      // owner অথবা super admin — staff-কে deleteNotebook cascade দিয়ে আটকানো,
      // নিচের pages subcollection delete rule একই কারণে super-only
      allow delete: if request.auth != null &&
                    (resource.data.ownerId == request.auth.uid || isSuperAdmin());

      // ============================================
      // ✅ PAGES SUBCOLLECTION — admin panel read করে + delete করে (notebook
      // delete cascade এর অংশ), কখনো create/update করে না
      // ============================================
      match /pages/{pageId} {
        allow read: if request.auth != null &&
                     (get(/databases/$(database)/documents/notebooks/$(notebookId)).data.ownerId == request.auth.uid || isAdmin());
        allow write: if request.auth != null &&
                     (get(/databases/$(database)/documents/notebooks/$(notebookId)).data.ownerId == request.auth.uid || isSuperAdmin());
      }
    }

    // ডিফল্টভাবে অন্য সব রিড-রাইট বন্ধ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
