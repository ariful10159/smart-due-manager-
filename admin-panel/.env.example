# Firebase Console > App Check > Apps > (web app) > reCAPTCHA v3 site key.
# Copy this file to .env (or .env.local), fill in the key, then rebuild.
# Left empty/unset, App Check is simply skipped (see src/firebase.js) — safe default
# until App Check is registered in the console.
VITE_RECAPTCHA_SITE_KEY=

# Sentry project DSN (sentry.io > Settings > Projects > (project) > Client Keys).
# Left empty/unset, error reporting is simply skipped (see src/sentry.js) — safe default
# until a Sentry project exists.
VITE_SENTRY_DSN=
