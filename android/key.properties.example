# Template for android/key.properties (release signing credentials).
#
# 1. Copy this file to "android/key.properties" (same folder as this file).
# 2. Fill in the real values below in your copy.
# 3. NEVER commit android/key.properties or your .jks/.keystore file — both are
#    already excluded via android/.gitignore (key.properties, **/*.jks, **/*.keystore).
#
# storeFile is resolved relative to the android/app/ directory (not android/), e.g. if
# your keystore lives at android/app/smart_due_release.jks, use: storeFile=smart_due_release.jks
# (An absolute path, e.g. to a keystore stored outside the repo entirely, also works.)

storePassword=REPLACE_WITH_YOUR_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
keyAlias=REPLACE_WITH_YOUR_KEY_ALIAS
storeFile=REPLACE_WITH_PATH_TO_YOUR_KEYSTORE_FILE
